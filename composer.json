{
    "name": "stolt/config-cartographer",
    "description": "A PHP library and CLI for discovering, tracing, and visualizing application configuration dependencies.",
    "keywords": [
        "configuration",
        "static-analysis",
        "dependency-graph",
        "environment-variables"
    ],
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "symfony/console": "^6.4|^7.0",
        "symfony/finder": "^6.4|^7.0",
        "symfony/yaml": "^6.4|^7.0",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "ConfigCartographer\\": "src/"
        }
    },
    "bin": [
        "bin/config-cartographer"
    ],
    "config": {
        "sort-packages": true
    }
}
